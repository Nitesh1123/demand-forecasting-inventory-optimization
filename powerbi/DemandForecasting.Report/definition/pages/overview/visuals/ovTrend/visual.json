{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "ovTrend",
  "position": {
    "x": 20,
    "y": 292,
    "z": 12,
    "width": 760,
    "height": 418,
    "tabOrder": 12
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_start"
                }
              },
              "queryRef": "dim_date.month_start",
              "nativeQueryRef": "month_start"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Total Sales"
                }
              },
              "queryRef": "fact_sales.Total Sales",
              "nativeQueryRef": "Total Sales"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_forecast"
                    }
                  },
                  "Property": "Forecast Units"
                }
              },
              "queryRef": "fact_forecast.Forecast Units",
              "nativeQueryRef": "Forecast Units"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly sales with the 90-day LightGBM forecast'"
                }
              }
            }
          }
        }
      ]
    }
  }
}