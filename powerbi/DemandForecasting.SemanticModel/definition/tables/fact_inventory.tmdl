table fact_inventory
	lineageTag: a7561f3c-c87a-551e-b9a7-a0df7a256a30

	measure 'Inventory Demand' = SUM ( fact_inventory[actual_demand] )
		formatString: #,0
		lineageTag: df96f706-741c-5f0c-ae9d-c30e6415ad3e

	measure 'Allocated Supply' = SUM ( fact_inventory[pulp_allocation] )
		formatString: #,0
		lineageTag: f58682a3-3bc3-5191-bf77-36e6dc21d3b5

	measure 'Unmet Demand (Optimised)' = SUM ( fact_inventory[pulp_actual_unmet] )
		formatString: #,0
		lineageTag: 7cc085ed-ab2d-5b96-894e-0c1053835841

	measure 'Unmet Demand (Proportional)' = SUM ( fact_inventory[proportional_actual_unmet] )
		formatString: #,0
		lineageTag: 5d1d8e63-fdb0-5f6c-8f2c-a8fd0ca83a78

	measure 'Unmet Demand (Equal Split)' = SUM ( fact_inventory[equal_split_actual_unmet] )
		formatString: #,0
		lineageTag: 37690343-74f0-565a-8f44-6a5509d1a333

	measure 'Fill Rate (Optimised)' = 1 - DIVIDE ( [Unmet Demand (Optimised)], [Inventory Demand] )
		formatString: 0.0%
		lineageTag: 01ff02de-f2e0-5bbf-8fcb-5ddcc1d66d66

	measure 'Fill Rate (Proportional)' = 1 - DIVIDE ( [Unmet Demand (Proportional)], [Inventory Demand] )
		formatString: 0.0%
		lineageTag: b6b5d35f-d054-5165-b512-a42b01828b30

	measure 'Fill Rate (Equal Split)' = 1 - DIVIDE ( [Unmet Demand (Equal Split)], [Inventory Demand] )
		formatString: 0.0%
		lineageTag: dd492b04-7443-5bce-9029-fcf43d267c6b

	measure 'Worst Fill Rate (Optimised)' = MINX ( fact_inventory, 1 - DIVIDE ( fact_inventory[pulp_actual_unmet], fact_inventory[actual_demand] ) )
		formatString: 0.0%
		lineageTag: 85478c41-6ba4-5e0c-929f-fca6acfe6e62

	measure 'Worst Fill Rate (Equal Split)' = MINX ( fact_inventory, 1 - DIVIDE ( fact_inventory[equal_split_actual_unmet], fact_inventory[actual_demand] ) )
		formatString: 0.0%
		lineageTag: 83b8f01d-5751-5f8b-8ce4-38b99e74ca8a

	measure 'Fill Rate Color' = SWITCH ( TRUE (), ISBLANK ( [Fill Rate (Optimised)] ), BLANK (), [Fill Rate (Optimised)] >= 0.8, "#C8E6C9", [Fill Rate (Optimised)] >= 0.7, "#FFF3C4", "#FFCDD2" )
		lineageTag: 8c07f4a9-c1e8-5a86-bab4-ce9c2adaff7e

	measure 'Safety Stock (What-if)' = SUMX ( fact_inventory, NORM.S.INV ( [Service Level Value] ) * fact_inventory[residual_std_daily] * SQRT ( [Lead Time Value] ) )
		formatString: #,0
		lineageTag: ae075aa0-50c8-578d-b6f4-f2ff3c1ea965

	measure 'Reorder Point (What-if)' = SUMX ( fact_inventory, fact_inventory[forecast_mean_daily_demand] * [Lead Time Value] ) + [Safety Stock (What-if)]
		formatString: #,0
		lineageTag: 4af02554-b387-5cc3-8f46-ff343e72c782

	measure 'Inventory Insight' = "With supply capped at 80% of forecast, the optimised allocation keeps every store-item at or above " & FORMAT ( [Worst Fill Rate (Optimised)], "0%" ) & " fill rate (equal split: " & FORMAT ( [Worst Fill Rate (Equal Split)], "0%" ) & "). At a " & FORMAT ( [Service Level Value], "0%" ) & " service level and " & [Lead Time Value] & "-day lead time, safety stock is " & FORMAT ( [Safety Stock (What-if)], "#,0" ) & " units."
		lineageTag: fe35a80b-f8f7-5f37-acc1-c822f3e4fb4b

	column item
		dataType: int64
		formatString: 0
		lineageTag: 1e60b38c-dae9-591b-9b2e-a539346464b0
		summarizeBy: none
