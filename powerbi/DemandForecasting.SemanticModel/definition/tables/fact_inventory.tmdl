		dataType: double
		formatString: #,0.00
		lineageTag: b24e0a09-ea27-5d77-abe5-e8737e146af9
		summarizeBy: sum
		sourceColumn: residual_std_daily

	column safety_stock
		dataType: double
		formatString: #,0.00
		lineageTag: 77c8fef3-5435-5993-822c-228a6fa407b6
		summarizeBy: sum
		sourceColumn: safety_stock

	column reorder_point
		dataType: double
		formatString: #,0.00
		lineageTag: 2efdccf8-d5f9-5f0f-9c43-1d0048e30eb7
		summarizeBy: sum
		sourceColumn: reorder_point

	partition fact_inventory = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_inventory.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"item", Int64.Type}, {"store", Int64.Type}, {"forecast_demand", type number}, {"actual_demand", type number}, {"total_item_supply", Int64.Type}, {"pulp_allocation", Int64.Type}, {"proportional_allocation", Int64.Type}, {"equal_split_allocation", Int64.Type}, {"pulp_actual_unmet", type number}, {"proportional_actual_unmet", type number}, {"equal_split_actual_unmet", type number}, {"forecast_mean_daily_demand", type number}, {"residual_std_daily", type number}, {"safety_stock", type number}, {"reorder_point", type number}}, "en-US")
				in
				    Typed
