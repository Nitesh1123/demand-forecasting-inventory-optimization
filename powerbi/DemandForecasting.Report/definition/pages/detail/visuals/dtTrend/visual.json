{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "dtTrend",
  "position": {
    "x": 20,
    "y": 165,
    "z": 8,
    "width": 1240,
    "height": 320,
    "tabOrder": 8
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "dim_date.date",
              "nativeQueryRef": "date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_forecast"
                    }
                  },
                  "Property": "Actual Units"
                }
              },
              "queryRef": "fact_forecast.Actual Units",
              "nativeQueryRef": "Actual Units"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_forecast"
                    }
                  },
                  "Property": "Forecast Units"
                }
              },
              "queryRef": "fact_forecast.Forecast Units",
              "nativeQueryRef": "Forecast Units"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_forecast"
                    }
                  },
                  "Property": "Baseline Units"
                }
              },
              "queryRef": "fact_forecast.Baseline Units",
              "nativeQueryRef": "Baseline Units"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_forecast"
                    }
                  },
                  "Property": "Forecast Chart Title"
                }
              }
            }
          }
        }
      ]
    }
  }
}