{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "ovStores",
  "position": {
    "x": 800,
    "y": 510,
    "z": 14,
    "width": 460,
    "height": 200,
    "tabOrder": 14
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_store"
                    }
                  },
                  "Property": "store_name"
                }
              },
              "queryRef": "dim_store.store_name",
              "nativeQueryRef": "store_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Total Sales"
                }
              },
              "queryRef": "fact_sales.Total Sales",
              "nativeQueryRef": "Total Sales"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Sales by store (right-click a bar to drill through)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}