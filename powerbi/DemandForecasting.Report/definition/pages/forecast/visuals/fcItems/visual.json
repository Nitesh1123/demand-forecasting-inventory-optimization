{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "fcItems",
  "position": {
    "x": 20,
    "y": 492,
    "z": 12,
    "width": 700,
    "height": 218,
    "tabOrder": 12
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_item"
                    }
                  },
                  "Property": "item_name"
                }
              },
              "queryRef": "dim_item.item_name",
              "nativeQueryRef": "item_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_forecast"
                    }
                  },
                  "Property": "WAPE"
                }
              },
              "queryRef": "fact_forecast.WAPE",
              "nativeQueryRef": "WAPE"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_forecast"
                    }
                  },
                  "Property": "Baseline WAPE"
                }
              },
              "queryRef": "fact_forecast.Baseline WAPE",
              "nativeQueryRef": "Baseline WAPE"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'WAPE by item: LightGBM vs baseline (click a bar to filter)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}