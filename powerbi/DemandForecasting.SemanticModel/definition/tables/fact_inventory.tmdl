		sourceColumn: pulp_allocation

	column proportional_allocation
		dataType: int64
		formatString: 0
		lineageTag: 80319c08-e227-5537-81f8-78d36a83b846
		summarizeBy: sum
		sourceColumn: proportional_allocation

	column equal_split_allocation
		dataType: int64
		formatString: 0
		lineageTag: a4f517e7-5324-5399-892b-79de6b28c383
		summarizeBy: sum
		sourceColumn: equal_split_allocation

	column pulp_actual_unmet
		dataType: double
		formatString: #,0.00
		lineageTag: 85be9ab6-e8e1-5f71-8a46-33b08bc2d77b
		summarizeBy: sum
		sourceColumn: pulp_actual_unmet

	column proportional_actual_unmet
		dataType: double
		formatString: #,0.00
		lineageTag: 69454408-6893-5b9f-98bf-84c0dd6c7ccb
		summarizeBy: sum
		sourceColumn: proportional_actual_unmet

	column equal_split_actual_unmet
		dataType: double
		formatString: #,0.00
		lineageTag: 4c7ee3d2-86f1-5026-b556-9844a4931ac7
		summarizeBy: sum
		sourceColumn: equal_split_actual_unmet

	column forecast_mean_daily_demand
		dataType: double
		formatString: #,0.00
		lineageTag: 2ebf5cab-13e7-5942-ae31-6637ff8eb9ec
		summarizeBy: sum
		sourceColumn: forecast_mean_daily_demand

